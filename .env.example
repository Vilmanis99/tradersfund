# Brevo server-side integration
BREVO_API_KEY=xkeysib-replace-me

# Contact form: the sender must be verified in Brevo.
BREVO_CONTACT_TO_EMAIL=editor@example.com
BREVO_CONTACT_FROM_EMAIL=website@example.com
BREVO_CONTACT_FROM_NAME=Traders Fund Hub

# Newsletter: use a Brevo list and a valid double-opt-in template.
BREVO_NEWSLETTER_LIST_ID=1
BREVO_NEWSLETTER_DOI_TEMPLATE_ID=2
BREVO_NEWSLETTER_REDIRECT_URL=https://tradersfundhub.com/newsletter-confirmed

# Optional, consent-gated journey analytics. Leave blank to keep these providers disabled.
# Vercel Web Analytics and Speed Insights use the Vercel project settings and need no env values.
# Before enabling GA4, disable Enhanced Measurement's browser-history page changes; code sends
# sanitized pathname-only page views. Before enabling Clarity, mask URL query parameters in its
# project settings so shortlist and planner state never enters session URLs.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
